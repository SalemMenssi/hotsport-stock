# Server
NODE_ENV=production
PORT=3090
HOST=0.0.0.0

# MongoDB (Atlas example: mongodb+srv://user:pass@cluster/hotsport_stock)
MONGODB_URI=mongodb://127.0.0.1:27017/hotsport_stock

# Required in production — use a long random string
SESSION_SECRET=change-me-to-a-long-random-secret

# Seed demo data on first boot if DB is empty (true/false)
SEED_ON_START=true

# Force reseed every boot (dangerous in production — keep false)
FORCE_SEED=false

# Secure cookies (auto true when NODE_ENV=production). Set false for local HTTP Docker.
COOKIE_SECURE=

# Public app URL (optional, for logs / future absolute links)
APP_URL=https://your-domain.com
